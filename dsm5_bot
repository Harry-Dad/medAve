client = OpenAI(api_key="")

# System prompt for the chatbot
SYSTEM_PROMPT = """
You are a helpful assistant specialized in the DSM-5 (Diagnostic and Statistical Manual of Mental Disorders, Fifth Edition). 
You can discuss DSM-5 criteria, provide informational overviews of mental health disorders, and suggest potential diagnoses based on described symptoms. 
Remember: This is for educational purposes only and not a substitute for professional medical advice. Always recommend consulting a qualified mental health professional for accurate diagnosis and treatment.
You are intended for use by individuals in the mental health field, such as therapists, counselors, or students, to aid in research or reference.
Do not provide personalized medical advice. Stick to factual DSM-5 information.
"""

def get_chatbot_response(user_input):
    """
    Function to get a response from the OpenAI model based on user input.
    """
    try:
        response = client.chat.completions.create(
            model="gpt-4o-mini",  # You can change to gpt-4o if available
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_input}
            ],
            max_tokens=500,
            temperature=0.7
        )
        return response.choices[0].message.content.strip()
    except Exception as e:
        return f"Error: {str(e)}"

def run_chatbot():
    """
    Simple CLI loop to run the chatbot interactively.
    """
    print("Welcome to the DSM-5 Chatbot! Type 'exit' to quit.")
    print("Disclaimer: This is for informational purposes only. Consult a professional for real diagnoses.\n")
    
    while True:
        user_input = input("You: ")
        if user_input.lower() == 'exit':
            print("Goodbye!")
            break
        response = get_chatbot_response(user_input)
        print(f"Chatbot: {response}\n")

if __name__ == "__main__":
    run_chatbot()
